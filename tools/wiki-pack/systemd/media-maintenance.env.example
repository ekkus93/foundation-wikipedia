# Copy to ~/.config/foundation-wikipedia/media-maintenance.env (mode 0600).
# Replace BOTH placeholders with absolute paths to an existing, private root
# and its independently bound, existing SQLite registry (outside the root).
# systemd EnvironmentFile is not a shell: do not use ~ or $HOME.
MEDIA_ROOT=/ABSOLUTE/PATH/TO/media
REGISTRY_PATH=/ABSOLUTE/PATH/TO/media-owners.sqlite
# These bounds are per invocation, not total storage quotas (1..10000).
MAX_REGISTERED=1000
MAX_SCANNED=10000
# Last successful run must be at least this many seconds old (60..2592000).
INTERVAL_SECONDS=86400
