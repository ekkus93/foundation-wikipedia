{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Foundation Wikipedia",
  "version": "0.1.0",
  "identifier": "org.foundation.wikipedia",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Foundation Wikipedia",
        "width": 1280,
        "height": 800,
        "minWidth": 700,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
